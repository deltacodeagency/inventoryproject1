# Production URL of the deployed Vercel application.
# Example: https://your-project.vercel.app
BETTER_AUTH_URL="https://your-project.vercel.app"

# Long random secret used by Better Auth. Generate a unique value for Vercel.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# PostgreSQL/Neon connection string used by Prisma and Better Auth.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Google OAuth credentials.
# Add https://your-project.vercel.app/api/auth/callback/google to Google Cloud Console.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ImgBB image hosting.
IMGBB_UPLOAD_URL="https://api.imgbb.com/1/upload"
IMGBB_API_KEY="your-imgbb-api-key"

# Resend email configuration for password reset and verification emails.
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="inventory@your-domain.com"

# Optional Gemini integration.
GEMINI_API_KEY="your-gemini-api-key"

# Optional local image fallback. Keep disabled/empty on Vercel because its
# filesystem is ephemeral; ImgBB should be configured for production uploads.
IMGBB_FALLBACK_LOCAL="false"

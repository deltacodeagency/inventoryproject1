// Prisma schema for Local Shop Inventory Management System with Better Auth

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// BETTER AUTH AUTHENTICATION MODELS
// ==========================================

model User {
  id            String    @id
  name          String
  fullName      String    @default("")
  email         String
  emailVerified Boolean
  image         String?
  role          String?   // Administrator, Manager, Salesman
  password      String?   // bcrypt hash; never store plaintext passwords
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ==========================================
// INVENTORY MANAGEMENT DOMAIN MODELS
// ==========================================

model Category {
  id          String    @id @default(cuid())
  name        String
  description String
  code        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("category")
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  description String
  logo        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("brand")
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String
  taxId     String?
  address   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
  purchases Purchase[]

  @@map("supplier")
}

model Product {
  id               String            @id @default(cuid())
  sku              String            @unique
  name             String
  description      String
  price            Float
  cost             Float
  stock            Int
  minStockAlert    Int
  image            String
  status           String            // 'active' | 'inactive'
  createdBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  brandId          String
  brand            Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  
  supplierId       String
  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  batches          ProductBatch[]
  saleItems        SaleItem[]
  purchaseItems    PurchaseItem[]
  stockAdjustments StockAdjustment[]
  stockTransfers   StockTransfer[]

  @@map("product")
}

model ProductBatch {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int
  initialQuantity Int
  cost            Float
  price           Float
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("product_batch")
}

model Sale {
  id              String     @id @default(cuid())
  invoiceNo       String     @unique
  receiptSerial   String?
  date            DateTime   @default(now())
  customerName    String
  subtotal        Float
  discount        Float      @default(0)
  tax             Float      @default(0)
  total           Float
  paidAmount      Float
  paymentMethod   String     // 'Cash' | 'Card' | 'Mobile' | 'bKash' | 'Nagad' | 'Rocket'
  status          String     // 'Paid' | 'Partial' | 'Returned'
  salesperson     String
  isOffline       Boolean    @default(false)
  costOfGoodsSold Float?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  items           SaleItem[]
  returns         Return[]

  @@map("sale")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName String
  quantity    Int
  price       Float
  cost        Float?

  @@map("sale_item")
}

model Purchase {
  id           String         @id @default(cuid())
  purchaseNo   String         @unique
  date         DateTime       @default(now())
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierName String
  total        Float
  status       String         // 'Received' | 'Pending' | 'Ordered'
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  items        PurchaseItem[]

  @@map("purchase")
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName String
  quantity    Int
  cost        Float

  @@map("purchase_item")
}

model Return {
  id          String       @id @default(cuid())
  returnNo    String       @unique
  saleId      String
  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  invoiceNo   String
  date        DateTime     @default(now())
  refundTotal Float
  reason      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  items       ReturnItem[]

  @@map("return")
}

model ReturnItem {
  id           String @id @default(cuid())
  returnId     String
  return       Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId    String
  productName  String
  quantity     Int
  refundAmount Float

  @@map("return_item")
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  amount      Float
  date        DateTime @default(now())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expense")
}

model Income {
  id          String   @id @default(cuid())
  category    String
  amount      Float
  date        DateTime @default(now())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("income")
}

model StockAdjustment {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName String
  sku         String
  type        String   // 'addition' | 'deduction'
  quantity    Int
  reason      String   // 'Damage' | 'Theft' | 'Inventory Count' | 'Promotional Sample' | 'Other'
  notes       String?
  date        DateTime @default(now())
  adjustedBy  String
  cost        Float?
  price       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("stock_adjustment")
}

model StockTransfer {
  id                  String   @id @default(cuid())
  transferNo          String   @unique
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productName         String
  sku                 String
  quantity            Int
  sourceLocation      String   // 'Main Warehouse' | 'Downtown Store' | 'Uptown Store' | 'Westside Branch'
  destinationLocation String
  status              String   // 'Pending' | 'Completed' | 'Cancelled'
  date                DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("stock_transfer")
}

model Alert {
  id          String   @id @default(cuid())
  type        String   // 'low_stock' | 'system' | 'sales'
  title       String
  message     String
  date        DateTime @default(now())
  read        Boolean  @default(false)
  referenceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("alert")
}

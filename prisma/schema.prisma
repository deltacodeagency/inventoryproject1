generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  role          String?
  createdAt     DateTime
  updatedAt     DateTime
  fullName      String    @default("")
  password      String?
  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String
  code        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("category")
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  description String
  logo        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("brand")
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String
  taxId     String?
  address   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
  purchases Purchase[]

  @@map("supplier")
}

model Product {
  id               String            @id @default(cuid())
  sku              String            @unique
  name             String
  description      String
  price            Float
  cost             Float
  stock            Int
  minStockAlert    Int
  image            String
  status           String
  createdBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  categoryId       String
  brandId          String
  supplierId       String
  brand            Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  batches          ProductBatch[]
  purchaseItems    PurchaseItem[]
  saleItems        SaleItem[]
  stockAdjustments StockAdjustment[]
  stockTransfers   StockTransfer[]

  @@map("product")
}

model ProductBatch {
  id              String   @id @default(cuid())
  productId       String
  quantity        Int
  initialQuantity Int
  cost            Float
  price           Float
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_batch")
}

model Sale {
  id              String     @id @default(cuid())
  invoiceNo       String     @unique
  receiptSerial   String?
  date            DateTime   @default(now())
  customerName    String
  subtotal        Float
  discount        Float      @default(0)
  tax             Float      @default(0)
  total           Float
  paidAmount      Float
  paymentMethod   String
  status          String
  salesperson     String
  isOffline       Boolean    @default(false)
  costOfGoodsSold Float?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  returns         Return[]
  items           SaleItem[]

  @@map("sale")
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  productName String
  quantity    Int
  price       Float
  cost        Float?
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_item")
}

model Purchase {
  id           String         @id @default(cuid())
  purchaseNo   String         @unique
  date         DateTime       @default(now())
  supplierId   String
  supplierName String
  total        Float
  status       String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items        PurchaseItem[]

  @@map("purchase")
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  productId   String
  productName String
  quantity    Int
  cost        Float
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("purchase_item")
}

model Return {
  id          String       @id @default(cuid())
  returnNo    String       @unique
  saleId      String?
  invoiceNo   String
  date        DateTime     @default(now())
  refundTotal Float
  reason      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sale        Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items       ReturnItem[]

  @@map("return")
}

model ReturnItem {
  id           String @id @default(cuid())
  returnId     String
  productId    String
  productName  String
  quantity     Int
  refundAmount Float
  return       Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_item")
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  amount      Float
  date        DateTime @default(now())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expense")
}

model Income {
  id          String   @id @default(cuid())
  category    String
  amount      Float
  date        DateTime @default(now())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("income")
}

model StockAdjustment {
  id          String   @id @default(cuid())
  productId   String
  productName String
  sku         String
  type        String
  quantity    Int
  reason      String
  notes       String?
  date        DateTime @default(now())
  adjustedBy  String
  cost        Float?
  price       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_adjustment")
}

model StockTransfer {
  id                  String   @id @default(cuid())
  transferNo          String   @unique
  productId           String
  productName         String
  sku                 String
  quantity            Int
  sourceLocation      String
  destinationLocation String
  status              String
  date                DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_transfer")
}

model Alert {
  id          String   @id @default(cuid())
  type        String
  title       String
  message     String
  date        DateTime @default(now())
  read        Boolean  @default(false)
  referenceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("alert")
}
